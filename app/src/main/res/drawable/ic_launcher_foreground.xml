<?xml version="1.0" encoding="utf-8"?>
<!-- Yiḍ's launcher glyph: a bat among gold stars.
     The bat is a grey bitmap, its zones taken from a reference image (light
     body, darker arms and legs, the wings in between), multiplied by a dark
     tone of the wallpaper's accent, so it follows the wallpaper and keeps
     its zones. The stars are gold on every wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/yid_bat_shadow" />
    <item>
        <bitmap
            android:src="@drawable/yid_bat"
            android:tint="@color/ic_launcher_bat"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/yid_stars" />
</layer-list>
