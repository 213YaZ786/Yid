<resources>
    <!--
      The launcher icon takes its paint from the wallpaper: the platform's
      dynamic palette, public since API 31, and minSdk is 31.

      As for MTGA and LinkedOut, the ground is the palest tone of the accent
      by day and a deep neutral by night. The bat is a dark tone of the
      accent, 700, by day and a light one, 300, by night, so it stands out of
      either ground; its bitmap only shades it. The crescent and the star
      are gold, fixed.
    -->
    <color name="ic_launcher_background">@android:color/system_accent1_50</color>
    <color name="ic_launcher_bat">@android:color/system_accent1_700</color>
</resources>
